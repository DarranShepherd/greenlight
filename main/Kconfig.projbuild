menu "Greenlight"

choice GREENLIGHT_BOARD_PROFILE
    prompt "Board profile"
    default GREENLIGHT_BOARD_PROFILE_ESP32_2432S028_ILI9341
    help
        Select the currently targeted board profile. This remains a single build-time
        selection and defaults to the existing 2.8-inch CYD behavior.

config GREENLIGHT_BOARD_PROFILE_ESP32_2432S028_ILI9341
    bool "ESP32-2432S028 / ILI9341"

config GREENLIGHT_BOARD_PROFILE_ESP32_2432S028_ST7789
    bool "ESP32-2432S028 / ST7789"

config GREENLIGHT_BOARD_PROFILE_ESP32_32E_ST7789
    bool "ESP32-32E / ST7789"

config GREENLIGHT_BOARD_PROFILE_JC4827W543
    bool "JC4827W543 / NV3041A / GT911"

endchoice

config GREENLIGHT_GITHUB_OWNER
    string "GitHub OTA owner"
    default "DarranShepherd"
    help
        GitHub owner or organization for OTA release metadata and firmware assets.

config GREENLIGHT_GITHUB_REPO
    string "GitHub OTA repository"
    default "greenlight"
    help
        GitHub repository name that publishes OTA firmware releases.

config GREENLIGHT_DOCS_SCREENSHOT_MODE
    bool "Enable documentation screenshot firmware mode"
    default n
    help
        Build a deterministic firmware path that skips Wi-Fi, time sync, and tariff
        refresh, renders curated UI states, and streams LVGL snapshots over UART so
        host tooling can regenerate documentation screenshots on demand.

endmenu